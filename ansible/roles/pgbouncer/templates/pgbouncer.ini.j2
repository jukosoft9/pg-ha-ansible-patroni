;; {{ ansible_managed }}

[databases]
;; Every database is served by the LOCAL PostgreSQL, over TLS (verify-full).
;; Leader discovery: clients use libpq multi-host + target_session_attrs=read-write
;; (or a LB health-checking Patroni's /primary endpoint).
* = host=127.0.0.1 port={{ postgresql_port }}

[pgbouncer]
listen_addr = {{ ansible_host }},127.0.0.1
listen_port = {{ pgbouncer_port }}
unix_socket_dir = /var/run/postgresql

;; Authentication: hba rules + SCRAM secrets looked up live from PostgreSQL
auth_type = hba
auth_hba_file = {{ pgbouncer_config_dir }}/pgbouncer_hba.conf
auth_file = {{ pgbouncer_config_dir }}/userlist.txt
auth_user = {{ pgbouncer_auth_username }}
auth_dbname = postgres
auth_query = SELECT usename, passwd FROM pgbouncer.get_auth($1)

admin_users = postgres
stats_users = postgres

;; Pooling
pool_mode = {{ pgbouncer_pool_mode }}
max_client_conn = {{ pgbouncer_max_client_conn }}
default_pool_size = {{ pgbouncer_default_pool_size }}
reserve_pool_size = {{ pgbouncer_reserve_pool_size }}
max_prepared_statements = {{ pgbouncer_max_prepared_statements }}
ignore_startup_parameters = extra_float_digits

;; TLS: clients -> PgBouncer (required)
client_tls_sslmode = require
client_tls_cert_file = {{ tls_node_cert }}
client_tls_key_file = {{ tls_node_key }}
client_tls_ca_file = {{ tls_ca_cert }}

;; TLS: PgBouncer -> PostgreSQL (certificate + hostname verified)
server_tls_sslmode = verify-full
server_tls_ca_file = {{ tls_ca_cert }}
